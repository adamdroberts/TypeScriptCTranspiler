catch-prelude-return-fulfilled: try:ok 
catch-prelude-return-rejected: caught:bad:Rbad Rbad
catch-prelude-throw: throw-bad:RbadTthrow-bad RbadTthrow-bad
catch-prelude-local-return: local:local-bad:RbadTthrow-bad:done
catch-prelude-local-throw: throw-local:local-throw
catch-prelude-uninitialized-local-return: uninit:uninit-local:RbadTthrow-bad
catch-prelude-uninitialized-local-throw: uninit-throw:uninit-throw:RbadTthrow-bad
