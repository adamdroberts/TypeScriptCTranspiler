/* Operation, public name, length, Map-only. WRITE selects set/add. */
TSC_COLLECTION_METHOD(GET, get, 1, true)
TSC_COLLECTION_METHOD(GET_OR_INSERT, getOrInsert, 2, true)
TSC_COLLECTION_METHOD(GET_OR_INSERT_COMPUTED, getOrInsertComputed, 2, true)
TSC_COLLECTION_METHOD(HAS, has, 1, false)
TSC_COLLECTION_METHOD(DELETE, delete, 1, false)
TSC_COLLECTION_METHOD(CLEAR, clear, 0, false)
TSC_COLLECTION_METHOD(KEYS, keys, 0, false)
TSC_COLLECTION_METHOD(VALUES, values, 0, false)
TSC_COLLECTION_METHOD(ENTRIES, entries, 0, false)
TSC_COLLECTION_METHOD(FOR_EACH, forEach, 1, false)
TSC_COLLECTION_METHOD(SIZE, size, 0, false)
TSC_COLLECTION_METHOD(WRITE, write, 0, false)
TSC_SET_COMPOSITION(UNION, union)
TSC_SET_COMPOSITION(INTERSECTION, intersection)
TSC_SET_COMPOSITION(DIFFERENCE, difference)
TSC_SET_COMPOSITION(SYMMETRIC_DIFFERENCE, symmetricDifference)
TSC_SET_COMPOSITION(SUBSET, isSubsetOf)
TSC_SET_COMPOSITION(SUPERSET, isSupersetOf)
TSC_SET_COMPOSITION(DISJOINT, isDisjointFrom)
