/* One operation collection; role bits parent=1, worker=2. */
TSC_AGENT_MEMBER(start, START, 1, 1)
TSC_AGENT_MEMBER(broadcast, BROADCAST, 2, 1)
TSC_AGENT_MEMBER(getReport, GET_REPORT, 0, 1)
TSC_AGENT_MEMBER(receiveBroadcast, RECEIVE, 1, 2)
TSC_AGENT_MEMBER(report, REPORT, 1, 2)
TSC_AGENT_MEMBER(leaving, LEAVING, 0, 2)
TSC_AGENT_MEMBER(sleep, SLEEP, 1, 3)
TSC_AGENT_MEMBER(monotonicNow, NOW, 0, 3)
