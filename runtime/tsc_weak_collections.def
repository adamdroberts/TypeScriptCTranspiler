TSC_WEAK_METHOD(WEAK_MAP, getOrInsert, WEAK_GET_OR_INSERT, 2)
TSC_WEAK_METHOD(WEAK_MAP, getOrInsertComputed, WEAK_GET_OR_INSERT_COMPUTED, 2)
TSC_WEAK_METHOD(WEAK_MAP, has, WEAK_HAS, 1)
TSC_WEAK_METHOD(WEAK_MAP, set, WEAK_SET_VALUE, 2)
TSC_WEAK_METHOD(WEAK_SET, add, WEAK_SET_VALUE, 1)
TSC_WEAK_METHOD(WEAK_SET, delete, WEAK_DELETE, 1)
TSC_WEAK_METHOD(WEAK_SET, has, WEAK_HAS, 1)
