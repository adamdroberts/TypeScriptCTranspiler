/* One descriptor collection for constructor/prototype publication. */
TSC_WEAK_COLLECTION(WeakMap, weak_map, WEAK_MAP, 0)
TSC_WEAK_COLLECTION(WeakSet, weak_set, WEAK_SET, 0)
TSC_WEAK_COLLECTION(WeakRef, weak_ref, WEAK_REF, 1)
TSC_WEAK_COLLECTION(FinalizationRegistry, finalization_registry, FINALIZATION_REGISTRY, 1)
TSC_WEAK_METHOD(WEAK_MAP, delete, WEAK_DELETE, 1)
TSC_WEAK_METHOD(WEAK_MAP, get, WEAK_GET, 1)
TSC_WEAK_METHOD(WEAK_MAP, getOrInsert, WEAK_GET_OR_INSERT, 2)
TSC_WEAK_METHOD(WEAK_MAP, getOrInsertComputed, WEAK_GET_OR_INSERT_COMPUTED, 2)
TSC_WEAK_METHOD(WEAK_MAP, has, WEAK_HAS, 1)
TSC_WEAK_METHOD(WEAK_MAP, set, WEAK_SET_VALUE, 2)
TSC_WEAK_METHOD(WEAK_SET, add, WEAK_SET_VALUE, 1)
TSC_WEAK_METHOD(WEAK_SET, delete, WEAK_DELETE, 1)
TSC_WEAK_METHOD(WEAK_SET, has, WEAK_HAS, 1)
TSC_WEAK_METHOD(WEAK_REF, deref, WEAK_DEREF, 0)
TSC_WEAK_METHOD(FINALIZATION_REGISTRY, register, WEAK_REGISTER, 2)
TSC_WEAK_METHOD(FINALIZATION_REGISTRY, unregister, WEAK_UNREGISTER, 1)
