/* Canonical Math callable descriptors shared by native publication and source analysis. */
TSC_MATH_UNARY(abs, fabs)
TSC_MATH_UNARY(acos, acos)
TSC_MATH_UNARY(acosh, acosh)
TSC_MATH_UNARY(asin, asin)
TSC_MATH_UNARY(asinh, asinh)
TSC_MATH_UNARY(atan, atan)
TSC_MATH_UNARY(atanh, atanh)
TSC_MATH_BINARY(atan2, atan2)
TSC_MATH_UNARY(cbrt, cbrt)
TSC_MATH_UNARY(ceil, ceil)
TSC_MATH_UNARY(clz32, tsc_math_clz32)
TSC_MATH_UNARY(cos, cos)
TSC_MATH_UNARY(cosh, cosh)
TSC_MATH_UNARY(exp, exp)
TSC_MATH_UNARY(expm1, expm1)
TSC_MATH_UNARY(f16round, tsc_math_f16round)
TSC_MATH_UNARY(floor, floor)
TSC_MATH_UNARY(fround, tsc_math_fround)
TSC_MATH_VARIADIC(hypot, 2.0, TSC_MATH_HYPOT)
TSC_MATH_BINARY(imul, tsc_math_imul)
TSC_MATH_UNARY(log, log)
TSC_MATH_UNARY(log1p, log1p)
TSC_MATH_UNARY(log10, log10)
TSC_MATH_UNARY(log2, log2)
TSC_MATH_VARIADIC(max, 2.0, TSC_MATH_MAX)
TSC_MATH_VARIADIC(min, 2.0, TSC_MATH_MIN)
TSC_MATH_BINARY(pow, tsc_number_exponentiate)
TSC_MATH_VARIADIC(random, 0.0, TSC_MATH_RANDOM)
TSC_MATH_UNARY(round, tsc_math_round)
TSC_MATH_UNARY(sign, tsc_math_sign)
TSC_MATH_UNARY(sin, sin)
TSC_MATH_UNARY(sinh, sinh)
TSC_MATH_UNARY(sqrt, sqrt)
TSC_MATH_VARIADIC(sumPrecise, 1.0, TSC_MATH_SUM_PRECISE)
TSC_MATH_UNARY(tan, tan)
TSC_MATH_UNARY(tanh, tanh)
TSC_MATH_UNARY(trunc, trunc)
