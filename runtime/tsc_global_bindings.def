TSC_GLOBAL_FUNCTION(eval, 1.0, TSC_GLOBAL_FUNCTION_EVAL, false, false, 0)
TSC_GLOBAL_FUNCTION(parseFloat, 1.0, TSC_GLOBAL_FUNCTION_PARSE_FLOAT, false, false, 0)
TSC_GLOBAL_FUNCTION(parseInt, 2.0, TSC_GLOBAL_FUNCTION_PARSE_INT, false, false, 0)
