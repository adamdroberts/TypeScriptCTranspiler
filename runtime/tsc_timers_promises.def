/* Name, operation, delay argument, payload argument, options argument,
 * queue, interval, function length, scheduler receiver. The compiler and native activation consume this List. */
TSC_TIMERS_PROMISE_OPERATION("setTimeout", TIMEOUT, 0, 1, 2, DELAYED, false, 2, false)
TSC_TIMERS_PROMISE_OPERATION("setImmediate", IMMEDIATE, -1, 0, 1, IMMEDIATE, false, 1, false)
TSC_TIMERS_PROMISE_OPERATION("setInterval", INTERVAL, 0, 1, 2, DELAYED, true, 2, false)
TSC_TIMERS_PROMISE_OPERATION("scheduler.wait", WAIT, 0, -1, 1, DELAYED, false, 2, true)
TSC_TIMERS_PROMISE_OPERATION("scheduler.yield", YIELD, -1, -1, -1, IMMEDIATE, false, 0, true)
