/* name, operation, argument shape, result profile, expected argument count.
 * Every export is an ordinary callable owner consuming one actual List. */
TSC_CHILD_PROCESS_OPERATION(exec, EXEC, COMMAND, CALLBACK, 3)
TSC_CHILD_PROCESS_OPERATION(execFile, EXEC_FILE, FILE_ARGUMENTS, CALLBACK, 4)
TSC_CHILD_PROCESS_OPERATION(execSync, EXEC_SYNC, COMMAND, BYTES, 2)
TSC_CHILD_PROCESS_OPERATION(execFileSync, EXEC_FILE_SYNC, FILE_ARGUMENTS, BYTES, 3)
TSC_CHILD_PROCESS_OPERATION(spawnSync, SPAWN_SYNC, FILE_ARGUMENTS, RESULT, 3)
TSC_CHILD_PROCESS_OPERATION(spawn, SPAWN, FILE_ARGUMENTS, CHILD, 3)
TSC_CHILD_PROCESS_OPERATION(fork, FORK, FILE_ARGUMENTS, UNREPRESENTED, 1)
