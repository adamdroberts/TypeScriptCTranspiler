/* One element collection drives DataView accessors and their function metadata. */
TSC_DATAVIEW_ELEMENT(Int8, 1, SIGNED)
TSC_DATAVIEW_ELEMENT(Uint8, 1, UNSIGNED)
TSC_DATAVIEW_ELEMENT(Int16, 2, SIGNED)
TSC_DATAVIEW_ELEMENT(Uint16, 2, UNSIGNED)
TSC_DATAVIEW_ELEMENT(Int32, 4, SIGNED)
TSC_DATAVIEW_ELEMENT(Uint32, 4, UNSIGNED)
TSC_DATAVIEW_ELEMENT(Float16, 2, FLOAT)
TSC_DATAVIEW_ELEMENT(Float32, 4, FLOAT)
TSC_DATAVIEW_ELEMENT(Float64, 8, FLOAT)
TSC_DATAVIEW_ELEMENT(BigInt64, 8, BIG_SIGNED)
TSC_DATAVIEW_ELEMENT(BigUint64, 8, BIG_UNSIGNED)
TSC_DATAVIEW_GETTER(buffer, BUFFER)
TSC_DATAVIEW_GETTER(byteLength, LENGTH)
TSC_DATAVIEW_GETTER(byteOffset, OFFSET)
