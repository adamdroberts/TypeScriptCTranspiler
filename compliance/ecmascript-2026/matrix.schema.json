{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typescriptc.invalid/schemas/ecmascript-2026-matrix.schema.json",
  "title": "TypeScriptC ECMAScript 2026 support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "choiceSelections", "normativeOptionalEvidence", "clauseEvidence", "groups"],
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "localEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "generatedRegression", "stress", "e2e", "negativeDiagnostics", "declarationSurface", "implementation"],
      "properties": {
        "property": { "$ref": "#/$defs/stringSet" },
        "generatedRegression": { "$ref": "#/$defs/stringSet" },
        "stress": { "$ref": "#/$defs/stringSet" },
        "e2e": { "$ref": "#/$defs/stringSet" },
        "negativeDiagnostics": { "$ref": "#/$defs/stringSet" },
        "declarationSurface": { "$ref": "#/$defs/stringSet" },
        "implementation": { "$ref": "#/$defs/stringSet" }
      }
    },
    "queryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "enum": ["clause", "esid", "feature", "flag", "mode"] },
        "equals": { "type": "string", "minLength": 1 }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allOf"],
      "properties": {
        "allOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/queryTerm" } }
      }
    },
    "coverageEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause", "partition", "relation", "xref"],
      "properties": {
        "clause": { "type": "string", "pattern": "^sec-" },
        "partition": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "relation": { "enum": ["references", "referenced-by"] },
        "xref": { "type": "string", "pattern": "^xref-[0-9a-f]{64}$" }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "surface", "cardinality", "choiceObligation", "definition", "normativeOptionalFamilies", "normativeOptionalSites", "test262Queries", "coveredBy", "localEvidence", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "surface": { "enum": ["syntax", "algorithm", "intrinsic", "module", "jobs-memory-model", "definition"] },
        "cardinality": { "enum": ["finite", "unbounded"] },
        "cardinalityMechanism": { "enum": ["canonical-collection", "tree", "graph", "worklist"] },
        "choiceObligation": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^choice-[0-9a-f]{64}$" }
          ]
        },
        "definition": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^definition-[0-9a-f]{64}$" }
          ]
        },
        "normativeOptionalFamilies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^optional-family-[0-9a-f]{64}$" },
          "uniqueItems": true
        },
        "normativeOptionalSites": {
          "type": "array",
          "items": { "type": "string", "pattern": "^optional-[0-9a-f]{64}$" },
          "uniqueItems": true
        },
        "test262Queries": { "type": "array", "items": { "$ref": "#/$defs/query" } },
        "coveredBy": { "type": "array", "items": { "$ref": "#/$defs/coverageEdge" } },
        "localEvidence": { "$ref": "#/$defs/localEvidence" },
        "rationale": { "type": "string", "minLength": 1 },
        "upstreamTestGap": { "type": "string", "pattern": "^https://" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": { "const": "baseline.json" },
    "clauseEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause", "disposition", "partitions", "rationale"],
        "properties": {
          "clause": { "type": "string", "pattern": "^sec-" },
          "disposition": { "const": "evidence" },
          "partitions": { "type": "array", "items": { "$ref": "#/$defs/partition" } },
          "rationale": { "type": "string", "minLength": 1 },
          "choice": false
        }
      }
    },
    "choiceSelections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation", "selection", "rationale", "reviewedBy", "evidence"],
        "properties": {
          "obligation": { "type": "string", "pattern": "^choice-[0-9a-f]{64}$" },
          "selection": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "reviewedBy": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clause", "partition"],
              "properties": {
                "clause": { "type": "string", "pattern": "^sec-" },
                "partition": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
              }
            }
          }
        }
      }
    },
    "normativeOptionalEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "policy", "rationale", "reviewedBy", "evidence"],
        "properties": {
          "family": { "type": "string", "pattern": "^optional-family-[0-9a-f]{64}$" },
          "policy": { "const": "implemented-all" },
          "rationale": { "type": "string", "minLength": 1 },
          "reviewedBy": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clause", "partition"],
              "properties": {
                "clause": { "type": "string", "pattern": "^sec-" },
                "partition": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "rootClause", "scope", "tracking", "semanticPartitions", "localEvidence", "knownGaps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "rootClause": { "type": "string", "pattern": "^sec-" },
          "scope": { "enum": ["required", "non-observable"] },
          "tracking": { "enum": ["todo", "in-progress", "ready-for-verification"] },
          "semanticPartitions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "localEvidence": { "$ref": "#/$defs/localEvidence" },
          "knownGaps": { "$ref": "#/$defs/stringSet" },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
