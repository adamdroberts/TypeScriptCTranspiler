{
  "schemaVersion": 1,
  "id": "tsc2c-native-test262-v1",
  "description": "Non-delegating native Test262 execution profile. It prepares runner-owned generated-C/native artifacts and is deliberately ineligible until every remaining host hook and phase classifier is implemented.",
  "command": ["bun", "tests/test262/native-host.ts"],
  "implementationFiles": [
    "runtime/tsc_runtime.h",
    "runtime/tsc_test262.c",
    "src/compile.ts",
    "src/emit/index.ts",
    "src/emit/types.ts",
    "src/program.ts",
    "src/resolve.ts",
    "tests/test262/native-host.ts",
    "tests/test262/protocol.ts"
  ],
  "executionContract": "tsc2c-runner-owned-native-v1",
  "environmentAllowlist": ["HOME", "PATH", "TMPDIR"],
  "claimEligible": false,
  "semanticDelegation": false,
  "capabilities": {
    "fresh-realm-per-scenario": true,
    "separate-global-script-setup": true,
    "script-goal": true,
    "module-goal-and-fixtures": false,
    "raw-source-preservation": true,
    "strict-variant-transform": true,
    "async-done-protocol": true,
    "structured-negative-phases": false,
    "exact-error-constructor": false,
    "failure-origin": false,
    "host-print": true,
    "host-$262-global": false,
    "host-$262-AbstractModuleSource": false,
    "host-$262-createRealm": false,
    "host-$262-evalScript": false,
    "host-$262-detachArrayBuffer": false,
    "host-$262-agent": false,
    "can-block-agent-selection": false,
    "host-$262-gc": false,
    "host-$262-IsHTMLDDA": false,
    "no-semantic-delegation": true
  }
}
