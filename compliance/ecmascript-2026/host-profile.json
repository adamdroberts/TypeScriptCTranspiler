{
  "schemaVersion": 1,
  "id": "tsc2c-native-test262-v1",
  "description": "Non-delegating native Test262 execution profile. It prepares runner-owned generated-C/native artifacts and is deliberately ineligible until every remaining host hook and language-semantic gap is implemented.",
  "command": ["bun", "tests/test262/native-host.ts"],
  "implementationFiles": [
    "bun.lock",
    "compliance/ecmascript-2026/evidence-registry.json",
    "compliance/ecmascript-2026/evidence-registry.schema.json",
    "package.json",
    "runtime/tsc_array.c",
    "runtime/tsc_builtin.c",
    "runtime/tsc_core.c",
    "runtime/tsc_dispatch.c",
    "runtime/tsc_internal.h",
    "runtime/tsc_map_set.c",
    "runtime/tsc_node.c",
    "runtime/tsc_node_embed.cc",
    "runtime/tsc_object.c",
    "runtime/tsc_promise.c",
    "runtime/tsc_runtime.h",
    "runtime/tsc_string.c",
    "runtime/tsc_test262.c",
    "runtime/tsc_value.c",
    "src/cli.ts",
    "src/commonjs-resolve.ts",
    "src/compile.ts",
    "src/diagnostics.ts",
    "src/dynamic-require.ts",
    "src/ecmascript-source.ts",
    "src/emit/async-cfg.ts",
    "src/emit/async-ir.ts",
    "src/emit/cbuf.ts",
    "src/emit/index.ts",
    "src/emit/mangle.ts",
    "src/emit/types.ts",
    "src/json-syntax.ts",
    "src/link/cc.ts",
    "src/module-request.ts",
    "src/module-specifiers.ts",
    "src/native-addons.ts",
    "src/program.ts",
    "src/resolve.ts",
    "src/runtime-code-aot.ts",
    "src/tools/check-emitter-method-reachability.ts",
    "stdlib/lib.core.d.ts",
    "tests/test262/HOST_PROTOCOL.md",
    "tests/test262/check-claim.ts",
    "tests/test262/check-matrix.ts",
    "tests/test262/diagnostic-host.ts",
    "tests/test262/feature-map.ts",
    "tests/test262/fetch.ts",
    "tests/test262/inventory.ts",
    "tests/test262/local-gates.ts",
    "tests/test262/matrix.ts",
    "tests/test262/merge-local-gates.ts",
    "tests/test262/merge-results.ts",
    "tests/test262/metadata.ts",
    "tests/test262/model.ts",
    "tests/test262/native-execution-guard.c",
    "tests/test262/native-host.ts",
    "tests/test262/process-supervision.ts",
    "tests/test262/process-supervisor.c",
    "tests/test262/protocol.ts",
    "tests/test262/render-matrix.ts",
    "tests/test262/run.ts",
    "tests/test262/self.test.ts",
    "tests/test262/spec-catalog.ts"
  ],
  "executionContract": "tsc2c-runner-owned-native-v1",
  "environmentAllowlist": ["HOME", "PATH", "TMPDIR"],
  "claimEligible": false,
  "semanticDelegation": false,
  "capabilities": {
    "fresh-realm-per-scenario": true,
    "separate-global-script-setup": true,
    "script-goal": true,
    "module-goal-and-fixtures": false,
    "raw-source-preservation": true,
    "strict-variant-transform": true,
    "async-done-protocol": true,
    "structured-negative-phases": true,
    "exact-error-constructor": true,
    "failure-origin": true,
    "host-print": true,
    "host-$262-global": true,
    "host-$262-AbstractModuleSource": true,
    "host-$262-createRealm": false,
    "host-$262-evalScript": true,
    "host-$262-detachArrayBuffer": true,
    "host-$262-agent": false,
    "can-block-agent-selection": false,
    "host-$262-gc": true,
    "host-$262-IsHTMLDDA": true,
    "no-semantic-delegation": true
  }
}
